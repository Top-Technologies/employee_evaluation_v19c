<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ==================== GROUPS ==================== -->

        <!-- Base Employee Group -->
        <record id="group_evaluation_employee" model="res.groups">
            <field name="name">Employee</field>
        </record>

        <!-- Direct Manager Group -->
        <record id="group_evaluation_manager" model="res.groups">
            <field name="name">Direct Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_evaluation_employee'))]"/>
        </record>

        <!-- Managing Director Group -->
        <record id="group_evaluation_md" model="res.groups">
            <field name="name">Managing Director</field>
            <field name="implied_ids" eval="[(4, ref('group_evaluation_manager'))]"/>
        </record>

        <!-- Operations Director Group -->
        <record id="group_evaluation_od" model="res.groups">
            <field name="name">Operations Director</field>
            <field name="implied_ids" eval="[(4, ref('group_evaluation_manager'))]"/>
        </record>

        <!-- Evaluation Administrator Group (granted ONLY to users with BOTH Administrator role AND Employee Admin access) -->
        <record id="group_evaluation_hr" model="res.groups">
            <field name="name">Evaluation Administrator</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Do NOT grant evaluation access automatically to System Administrators (must also have hr.group_hr_manager) -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(3, ref('group_evaluation_hr'))]"/>
        </record>

        <!-- Employee Access Level: Rename to 'User' and unlink HR Manager access -->
        <record id="hr.group_hr_user" model="res.groups">
            <field name="name">User</field>
            <field name="implied_ids" eval="[(3, ref('group_evaluation_hr'))]"/>
        </record>

        <!-- Do NOT grant evaluation access automatically to HR Managers alone (must also have base.group_system) -->
        <record id="hr.group_hr_manager" model="res.groups">
            <field name="implied_ids" eval="[(3, ref('group_evaluation_hr'))]"/>
        </record>

        <!-- ==================== RECORD RULES ==================== -->

        <!-- Evaluation Administrator: Can see all evaluations -->
        <record id="rule_evaluation_hr" model="ir.rule">
            <field name="name">Evaluation Administrator: All Evaluations</field>
            <field name="model_id" ref="model_employee_evaluation"/>
            <field name="groups" eval="[(4, ref('group_evaluation_hr'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
