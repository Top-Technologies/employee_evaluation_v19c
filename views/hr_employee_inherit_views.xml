<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Smart Button & Evaluations Tab on Employee Form -->
    <record id="view_hr_employee_form_inherit_evaluation" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.evaluation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Add Create Evaluation Action Button in Form Header -->
            <xpath expr="//header" position="inside">
                <button name="action_create_evaluation"
                        string="Create Evaluation"
                        type="object"
                        class="btn-primary"
                        groups="employee_evaluation_v19c.group_evaluation_manager"/>
            </xpath>

            <!-- Add Smart Button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_evaluations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-star"
                        groups="employee_evaluation_v19c.group_evaluation_employee">
                    <field name="evaluation_count" widget="statinfo" string="Evaluations"/>
                </button>
            </xpath>

            <!-- Add Employee Type field after parent_id -->
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="emp_eval_type"/>
            </xpath>

            <!-- Add Evaluations Tab in the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Evaluations" name="evaluations"
                      groups="employee_evaluation_v19c.group_evaluation_employee">
                    <div class="mb-3">
                        <button name="action_create_evaluation"
                                string="+ Create Evaluation for this Employee"
                                type="object"
                                class="btn btn-outline-primary"
                                groups="employee_evaluation_v19c.group_evaluation_manager"/>
                    </div>
                    <field name="evaluation_ids"
                           context="{'default_employee_id': id}">
                        <list string="Employee Evaluations"
                              create="1" edit="1"
                              decoration-info="state == 'draft'"
                              decoration-warning="state in ('manager_approved','md_approved','od_approved')"
                              decoration-primary="state == 'employee_reviewed'"
                              decoration-success="state == 'done'">
                            <field name="evaluation_type"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="total_score"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
