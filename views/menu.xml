<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ==================== ACTIONS ==================== -->

    <!-- All Evaluations -->
    <record id="action_employee_evaluation_all" model="ir.actions.act_window">
        <field name="name">All Evaluations</field>
        <field name="res_model">employee.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first employee evaluation
            </p>
            <p>
                Track and manage employee performance evaluations with a
                multi-step approval workflow.
            </p>
        </field>
    </record>

    <!-- 2 Months Evaluations -->
    <record id="action_evaluation_two_months" model="ir.actions.act_window">
        <field name="name">2 Months Evaluations</field>
        <field name="res_model">employee.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('evaluation_type', '=', 'two_months')]</field>
        <field name="context">{'default_evaluation_type': 'two_months'}</field>
    </record>

    <!-- 6 Months Evaluations -->
    <record id="action_evaluation_six_months" model="ir.actions.act_window">
        <field name="name">6 Months Evaluations</field>
        <field name="res_model">employee.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('evaluation_type', '=', 'six_months')]</field>
        <field name="context">{'default_evaluation_type': 'six_months'}</field>
    </record>

    <!-- ==================== MENUS ==================== -->

    <!-- Parent Menu under Employees: Strictly restricted to Manager and HR -->
    <record id="menu_employee_evaluation_root" model="ir.ui.menu">
        <field name="name">Employee Evaluation</field>
        <field name="parent_id" ref="hr.menu_hr_root"/>
        <field name="sequence">20</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('employee_evaluation_v19c.group_evaluation_manager'),
            ref('employee_evaluation_v19c.group_evaluation_hr'),
            ref('hr.group_hr_manager')
        ])]"/>
    </record>

    <!-- Sub-menus -->
    <record id="menu_evaluation_all" model="ir.ui.menu">
        <field name="name">All Evaluations</field>
        <field name="parent_id" ref="menu_employee_evaluation_root"/>
        <field name="action" ref="action_employee_evaluation_all"/>
        <field name="sequence">1</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('employee_evaluation_v19c.group_evaluation_manager'),
            ref('employee_evaluation_v19c.group_evaluation_hr'),
            ref('hr.group_hr_manager')
        ])]"/>
    </record>

    <record id="menu_evaluation_two_months" model="ir.ui.menu">
        <field name="name">2 Months Evaluation</field>
        <field name="parent_id" ref="menu_employee_evaluation_root"/>
        <field name="action" ref="action_evaluation_two_months"/>
        <field name="sequence">2</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('employee_evaluation_v19c.group_evaluation_manager'),
            ref('employee_evaluation_v19c.group_evaluation_hr'),
            ref('hr.group_hr_manager')
        ])]"/>
    </record>

    <record id="menu_evaluation_six_months" model="ir.ui.menu">
        <field name="name">6 Months Evaluation</field>
        <field name="parent_id" ref="menu_employee_evaluation_root"/>
        <field name="action" ref="action_evaluation_six_months"/>
        <field name="sequence">3</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('employee_evaluation_v19c.group_evaluation_manager'),
            ref('employee_evaluation_v19c.group_evaluation_hr'),
            ref('hr.group_hr_manager')
        ])]"/>
    </record>

    <record id="menu_evaluation_settings" model="ir.ui.menu">
        <field name="name">Settings</field>
        <field name="parent_id" ref="menu_employee_evaluation_root"/>
        <field name="action" ref="action_evaluation_config_settings"/>
        <field name="sequence">100</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('employee_evaluation_v19c.group_evaluation_hr'),
            ref('hr.group_hr_manager')
        ])]"/>
    </record>

    <!-- Restrict Employee Reporting menu to Administrator only so User access only sees employees -->
    <record id="hr.hr_menu_hr_reports" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('hr.group_hr_manager')])]"/>
    </record>

</odoo>
