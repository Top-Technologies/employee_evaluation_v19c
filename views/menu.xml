<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ==================== ACTIONS ==================== -->

    <!-- All Evaluations -->
    <record id="action_employee_evaluation_all" model="ir.actions.act_window">
        <field name="name">All Evaluations</field>
        <field name="res_model">employee.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first employee evaluation
            </p>
            <p>
                Track and manage employee performance evaluations with a
                multi-step approval workflow.
            </p>
        </field>
    </record>

    <!-- 2 Months Evaluations -->
    <record id="action_evaluation_two_months" model="ir.actions.act_window">
        <field name="name">2 Months Evaluations</field>
        <field name="res_model">employee.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('evaluation_type', '=', 'two_months')]</field>
        <field name="context">{'default_evaluation_type': 'two_months'}</field>
    </record>

    <!-- 6 Months Evaluations -->
    <record id="action_evaluation_six_months" model="ir.actions.act_window">
        <field name="name">6 Months Evaluations</field>
        <field name="res_model">employee.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('evaluation_type', '=', 'six_months')]</field>
        <field name="context">{'default_evaluation_type': 'six_months'}</field>
    </record>

    <!-- ==================== MENUS ==================== -->

    <!-- Parent Menu under Employees -->
    <menuitem id="menu_employee_evaluation_root"
              name="Employee Evaluation"
              parent="hr.menu_hr_root"
              sequence="20"
              groups="employee_evaluation_v19c.group_evaluation_employee"/>

    <!-- Sub-menus -->
    <menuitem id="menu_evaluation_all"
              name="All Evaluations"
              parent="menu_employee_evaluation_root"
              action="action_employee_evaluation_all"
              groups="employee_evaluation_v19c.group_evaluation_employee"
              sequence="1"/>

    <menuitem id="menu_evaluation_two_months"
              name="2 Months Evaluation"
              parent="menu_employee_evaluation_root"
              action="action_evaluation_two_months"
              groups="employee_evaluation_v19c.group_evaluation_employee"
              sequence="2"/>

    <menuitem id="menu_evaluation_six_months"
              name="6 Months Evaluation"
              parent="menu_employee_evaluation_root"
              action="action_evaluation_six_months"
              groups="employee_evaluation_v19c.group_evaluation_employee"
              sequence="3"/>

    <menuitem id="menu_evaluation_settings"
              name="Settings"
              parent="menu_employee_evaluation_root"
              action="action_evaluation_config_settings"
              groups="employee_evaluation_v19c.group_evaluation_hr"
              sequence="100"/>

</odoo>
